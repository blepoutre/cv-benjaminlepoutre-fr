---
import ContactForm from './ContactForm.astro';
---

<dialog id="contactModal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Me contacter</h2>
      <a id="closeModalBtn" type="button" class="close-x">&times;</a>
    </div>
    <ContactForm />
  </div>
</dialog>

<script>
  const dialog = document.getElementById('contactModal') as HTMLDialogElement;
  // On écoute la classe plutôt qu'un ID unique, ce qui permet d'avoir
  // autant de boutons "ouvrir" qu'on veut (Header, Footer, etc.)
  const openBtns = document.querySelectorAll('.openModalBtn');
  const closeBtn = document.getElementById('closeModalBtn');

  openBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      dialog?.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => {
    dialog?.close();
  });

  dialog?.addEventListener('click', (e) => {
    const rect = dialog.getBoundingClientRect();
    if (
      e.clientX < rect.left ||
      e.clientX > rect.right ||
      e.clientY < rect.top ||
      e.clientY > rect.bottom
    ) {
      dialog.close();
    }
  });
</script>

<style is:global>
  /* Styles globaux garantissant un affichage identique sur toutes les pages */
  dialog#contactModal {
    border: none;
    border-radius: 12px;
    padding: 0;
    width: 90% !important;
    max-width: 650px !important;
    background: var(--paper, #fff);
    color: var(--ink, #111);
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
    margin: auto;
  }

  dialog#contactModal::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  @media print {
    dialog#contactModal { display: none !important; }
  }

  .modal-content {
    padding: 2.5rem;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .modal-header h2 {
    font-size: 1.5rem;
    margin: 0;
  }

  a.openModalBtn {
    cursor: pointer !important;
  }

  .close-x {
    background: none;
    border: none;
    font-size: 1.75rem;
    cursor: pointer !important;
    color: var(--ink, #111);
    padding: 0.25rem;
    line-height: 1;
    transition: color 0.2s;
  }

  .close-x:hover {
    color: var(--accent, #b45309) !important;
  }
</style>
