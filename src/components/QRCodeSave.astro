---
// src/components/QRCode.astro
import * as QRCodeLib from 'qrcode';

interface Props {
  url: string;
  size?: number;
}

const { url, size = 80 } = Astro.props;

const qrcode = QRCodeLib as any;

// Utilisation de la méthode promise pour éviter les problèmes d'asynchronisme
const svgString = await qrcode.toString(url, {
  type: 'svg',
  margin: 1,
  errorCorrectionLevel: 'H',
  width: size,
});
---

<div class="qr-code" set:html={svgString} />

<style>
  .qr-code {
    display: block;
    width: 100%;
    height: 100%;
  }

  .qr-code :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
