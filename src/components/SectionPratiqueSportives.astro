---
interface Props { number: string }
const { number } = Astro.props

const sports = [
  {
    cat: "Golf",
    level: "HCP 13,4",
    name: "Pratique compétitive. Sport exigeant, pratiqué avec rigueur, adaptation et discipline personnelle.",
  },
  {
    cat: "Basketball",
    level: "Hebdomadaire",
    name: "Pratique régulière en amateur avec matches d'entraînement. Engagement collectif et amélioration continue.",
  },
  {
    cat: "Natation",
    level: "Pratique régulière",
    name: "Équilibre physique et mental. Démarche de soin personnel et de bien-être.",
  },
  {
    cat: "Mobilité douce",
    level: "Vélo — pratique quotidienne",
    name: "Engagement écologique et sportif intégré aux déplacements. Transport et activité physique combinés.",
  },
  {
    cat: "Bénévolat",
    level: "Route du Louvre — sécurisation du trajet",
    name: "Bénévole depuis 2 ans pour la logistique et la sécurité. Engagement civique direct",
  },
];
---

<section class="section">
  <div class="page">
    <div class="section-header">
      <span class="section-num">{number}</span>
      <h2>Pratique sportive</h2>
    </div>

    <div class="sports-grid">
      {sports.map((s) => (
        <div class="sport-item">
          <div class="sport-cat">{s.cat}</div>
          <div class="sport-level">{s.level}</div>
          <div class="sport-name">{s.name}</div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .section {
    padding: 4rem 0;
    border-bottom: 1px solid #e8d4a8;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .section-header {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .section-num {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  h2 {
    font-family: var(--serif);
    font-size: 1.8rem;
    letter-spacing: -0.01em;
  }

  .sports-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .sport-item {
    background: var(--paper);
    padding: 1rem 1.25rem;
    transition: background 0.2s;
  }

  @media (hover: hover) {
    .sport-item:hover { background: var(--card); }
  }

  .sport-cat {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .sport-level {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .sport-name {
    font-size: 0.9rem;
    color: var(--ink);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .sports-grid {
      grid-template-columns: 1fr;
      background: none;
      border: none;
      gap: 0;
    }

    .sport-item {
      background: transparent;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--rule);
    }

    .sport-item:last-child {
      border-bottom: none;
    }
  }

  @media print {
    .section { padding: 0.75rem 0; }
    .section-header { break-after: avoid; }
    .sports-grid {
      background: none;
      border: none;
    }
    .sport-item {
      border: 1px solid #ccc;
      padding: 0.5rem 0.75rem;
    }
  }
</style>
