---
// src/components/QRCode.astro
import QRCodeLib from 'qrcode';

interface Props {
  url: string;
  margin?: number; // zone blanche autour du QR, en nombre de modules
}

const { url, margin = 2 } = Astro.props;

const qrcode = QRCodeLib as any;
const qr = qrcode.create(url, { errorCorrectionLevel: 'H' });
const size = qr.modules.size;
const total = size + margin * 2;

// Les 3 carrés de repérage (7x7 modules) sont dessinés à part,
// on les exclut du semis de points.
const isFinder = (row: number, col: number) => {
  const topLeft = row < 7 && col < 7;
  const topRight = row < 7 && col >= size - 7;
  const bottomLeft = row >= size - 7 && col < 7;
  return topLeft || topRight || bottomLeft;
};

let dots = '';
for (let row = 0; row < size; row++) {
  for (let col = 0; col < size; col++) {
    if (!qr.modules.get(row, col)) continue;
    if (isFinder(row, col)) continue;
    const cx = col + margin + 0.5;
    const cy = row + margin + 0.5;
    dots += `<circle cx="${cx}" cy="${cy}" r="0.42" />`;
  }
}

const eyePositions = [
  { row: 0, col: 0 },
  { row: 0, col: size - 7 },
  { row: size - 7, col: 0 },
];

let eyes = '';
for (const { row, col } of eyePositions) {
  const x = col + margin;
  const y = row + margin;
  eyes += `
    <rect x="${x}" y="${y}" width="7" height="7" rx="2" ry="2" fill="none" stroke="black" class="qr-eye-ring" stroke-width="1.4" />
    <rect x="${x + 2}" y="${y + 2}" width="3" height="3" rx="1" ry="1" fill="black" class="qr-eye-dot" />
  `;
}

const svgString = `<svg viewBox="0 0 ${total} ${total}" xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision">
  <rect width="${total}" height="${total}" fill="white" />
  <g fill="black">${dots}</g>
  <g>${eyes}</g>
</svg>`;
---

<div class="qr-code" set:html={svgString} />

<style>
  .qr-code { display: block; width: 100%; height: 100%; }
  .qr-code :global(svg) { display: block; width: 100%; height: 100%; }
  .qr-code :global(.qr-eye-ring) { stroke: var(--accent); }
  .qr-code :global(.qr-eye-dot) { fill: var(--accent); }
</style>
